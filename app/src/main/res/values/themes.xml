<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 应用主题：Material3，品牌蓝主色，无 ActionBar（用自定义头部） -->
    <style name="Theme.Wanxiang" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_light</item>
        <item name="colorOnPrimaryContainer">@color/brand_dark</item>
        <item name="colorSecondary">@color/brand_soft</item>
        <item name="colorSecondaryContainer">@color/brand_light</item>
        <item name="colorOnSecondaryContainer">@color/brand_dark</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/line</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorControlActivated">@color/brand</item>
    </style>
</resources>
